{
  "manifest_version": 3,
  "name": "YouTube Dislike Restorer",
  "version": "0.1.1",
  "description": "Restore YouTube Dislike and add aggressive local ad filtering.",
  "permissions": ["identity", "storage", "declarativeNetRequest", "downloads", "offscreen"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_block_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Dislike Settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["adblock/ad_engine.js", "adblock/engine_bridge.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}

